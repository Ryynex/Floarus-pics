# Supabase (Auth, Storage & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Fal.ai GPU Inference Engine (FLUX 2 Pro)
FAL_KEY=your-fal-key

# Cloudinary (Catalog Storage & Relighting)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Payment & Platform
NEXT_PUBLIC_UPI_ID=your-upi-id@bank
OPENROUTER_API_KEY=your-openrouter-key

# Phase 2 & 3: Skin Micro-Pass (Automated Local Face & Skin Isolation)
# ENABLE_SKIN_MICRO_PASS=true
# SKIN_PASS_ROUTE=option_a                  # option_a (fal.ai micro-inpaint ~₹0.25) or option_b (100% local CPU ₹0.00)
# FAL_INPAINT_ENDPOINT=fal-ai/flux-general/inpainting
# SKIN_INPAINT_STRENGTH=0.30                 # Denoising strength: 0.28 to 0.35 preserves facial identity while injecting pores
# SKIN_DETECTOR_API_URL=https://your-python-service.onrender.com/detect # (Optional: required for Vercel serverless)


